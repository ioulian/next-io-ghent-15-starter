{
  "name": "next-io-ghent-15-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "// general": "echo 'General stuff'",
    "prepare": "husky",
    "postinstall": "husky",
    "// project": "echo 'Next.js specific stuff'",
    "dev": "pnpm svg-sprite:build && next typegen && next dev --experimental-https",
    "analyze": "pnpm svg-sprite:build && next typegen && cross-env ANALYZE=true pnpm build",
    "build": "pnpm check:build-prerequisites && pnpm svg-sprite:build && next typegen && next build",
    "start": "next start",
    "// code": "echo 'Code checks, linters and formatters'",
    "check:precommit": "pnpm format:code && pnpm check:all && pnpm test:all",
    "check:all": "pnpm check:lint && pnpm check:css && pnpm check:types && pnpm check:translations",
    "check:code": "knip --config knip.config.ts",
    "check:translations": "i18n-check -s en-GB --locales messages/",
    "check:build-prerequisites": "tsx scripts/check-build-prerequisites.ts",
    "check:lint": "eslint --fix .",
    "check:css": "pnpm dlx stylelint 'src/**/*.css' --fix",
    "check:types": "pnpm svg-sprite:build && next typegen && tsc --noemit --extendedDiagnostics",
    "format:code": "prettier --write .",
    "// storybook": "echo 'Storybook stuff'",
    "storybook": "pnpm svg-sprite:build && storybook dev -p 6006",
    "build-storybook": "pnpm svg-sprite:build && storybook build",
    "// tests": "echo 'Tests'",
    "test:all": "pnpm test && pnpm test:e2e && pnpm test:project-storybook",
    "test:storybook": "pnpm svg-sprite:build && test-storybook",
    "test": "vitest --watch false --project=default",
    "test:coverage": "vitest --watch false --project=default --coverage",
    "test:project-storybook": "vitest --watch false --project=storybook",
    "test:watch": "vitest --watch --project=default",
    "test:e2e": "playwright test",
    "// SVG Sprites": "echo 'SVG Sprites'",
    "svg-sprite:build": "tsx scripts/svg-sprite/index.ts && prettier --write ./src/components/atoms/svg-sprite/SvgSprite.generated.ts",
    "test:browser": "vitest"
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.0.0"
  },
  "dependencies": {
    "@bprogress/next": "3.2.12",
    "@floating-ui/react": "0.27.20",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tabler/icons": "3.46.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-table": "8.21.3",
    "@tiptap/extension-subscript": "3.30.5",
    "@tiptap/extension-superscript": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "clsx": "2.1.1",
    "colorjs.io": "0.7.1",
    "easing-coordinates": "2.0.2",
    "es-toolkit": "1.52.0",
    "flattie": "1.1.1",
    "next": "16.3.3",
    "next-intl": "4.14.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-paginate": "8.3.0",
    "react-tabs": "6.1.1",
    "react-toastify": "11.1.0",
    "react-use": "17.6.1",
    "swiper": "14.2.0",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.0",
    "@csstools/postcss-global-data": "4.0.0",
    "@faker-js/faker": "10.6.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@lingual/i18n-check": "0.9.5",
    "@next/bundle-analyzer": "16.3.3",
    "@next/env": "16.3.3",
    "@playwright/test": "1.62.1",
    "@rsc-boundary/next": "0.3.2",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-links": "10.5.10",
    "@storybook/addon-onboarding": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/nextjs-vite": "10.5.10",
    "@storybook/test-runner": "0.24.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/svg-sprite": "0.0.39",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "cross-env": "10.1.0",
    "cssnano": "9.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-baseline-js": "0.7.1",
    "eslint-plugin-css-modules-next": "1.6.0",
    "eslint-plugin-depend": "1.5.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-storybook": "10.5.10",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "knip": "6.32.3",
    "lint-staged": "17.4.1",
    "playwright": "1.62.1",
    "postcss": "8.5.26",
    "postcss-custom-media": "12.0.1",
    "postcss-import": "17.0.0",
    "postcss-nesting": "14.0.1",
    "postcss-preset-env": "11.5.0",
    "prettier": "3.9.6",
    "react-docgen-typescript": "2.4.0",
    "react-scan": "0.5.7",
    "storybook": "10.5.10",
    "storybook-addon-test-codegen": "3.0.4",
    "storybook-next-intl": "10.1.3",
    "stylelint": "17.14.1",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-standard": "40.0.0",
    "svg-sprite": "2.0.4",
    "ts-deepmerge": "8.0.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.2.2",
